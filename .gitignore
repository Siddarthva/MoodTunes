# NNDL / MoodTunes — Root .gitignore

# Python environments
.venv/
venv/
env/
ENV/

# Secrets / environment files
.env
*.env
!.env.example
*.local
*.secret
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Python cache / compiled files
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Python tooling / test caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ============================================================
# DATASETS — intentionally ignored
# ============================================================

# Generic dataset directories
dataset/
datasets/
**/dataset/
**/datasets/

# FER2013 / ML dataset directories
ml/data/
ml/data/**
**/fer2013/
**/FER2013/

# Original Emotion-detection image datasets
Emotion-detection/src/train/
Emotion-detection/src/test/

# Any class-image dataset folders
Emotion-detection/src/train/**
Emotion-detection/src/test/**

# Common dataset / archive formats
*.csv
*.tsv
*.jsonl
*.parquet
*.feather
*.pkl
*.pickle
*.npz
*.npy
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ============================================================
# PROJECT ARTIFACTS THAT MUST REMAIN TRACKED
# ============================================================

# Final trained MoodTunes model
!backend/app/models/emotion/*.keras
!backend/app/models/emotion/*.h5

# Model metadata / labels
!backend/app/models/emotion/emotion_labels.json
!backend/app/models/emotion/model_metadata.json
!backend/app/models/emotion/class_weights.json
!backend/app/models/emotion/model_summary.txt

# Training log
!backend/app/models/emotion/training_log.csv

# ML notebooks
!ml/notebooks/
!ml/notebooks/**/*.ipynb

# Keep source/config/documentation files
!backend/**/*.py
!frontend/**/*.js
!frontend/**/*.jsx
!frontend/**/*.ts
!frontend/**/*.tsx
!ml/**/*.py
!**/README.md
!**/.env.example

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ============================================================
# Node / React / Vite
# ============================================================
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

*.tsbuildinfo
.eslintcache

# Keep npm lockfile; ignore alternative package-manager locks
yarn.lock
pnpm-lock.yaml

# ============================================================
# IDE / editor
# ============================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo

# ============================================================
# OS files
# ============================================================
.DS_Store
.DS_Store?
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# Logs / temporary files
# ============================================================
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej

# ============================================================
# Python packaging artifacts
# ============================================================
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
wheels/

# ============================================================
# Local databases / runtime artifacts
# ============================================================
*.db
*.sqlite
*.sqlite3

# ============================================================
# Training checkpoints / experiment outputs
# ============================================================
checkpoints/
**/checkpoints/
runs/
**/runs/
tensorboard/
**/tensorboard/
*.ckpt
*.ckpt.index
*.ckpt.data-*

# Original repository caches
Emotion-detection/.pytest_cache/
Emotion-detection/**/__pycache__/
