PROJECT_NAME=MoodTunes API
DEBUG=true

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Emotion Provider settings (moodtunes_cnn | mock)
EMOTION_PROVIDER=moodtunes_cnn
EMOTION_MODEL_PATH=app/models/emotion/moodtunes_emotion_cnn.keras
EMOTION_LABELS_PATH=app/models/emotion/emotion_labels.json
FACE_CASCADE_PATH=app/models/haarcascade_frontalface_default.xml

# Music Provider settings (itunes)
MUSIC_PROVIDER=itunes
ITUNES_ENABLED=true

# Groq Music Intelligence settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
